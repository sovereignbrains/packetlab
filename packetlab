#!/usr/bin/env bash
# packetlab — управление стеком после установки.
# Ставится в /usr/local/bin/packetlab. Без аргументов открывает меню,
# с аргументами работает как обычный CLI (для скриптов и cron).
set -uo pipefail

PL_ROOT=${PL_ROOT:-/opt/packetlab}
. "$PL_ROOT/lib/ui.sh"
. "$PL_ROOT/lib/core.sh"      # pl_* хелперы: singbox, ufw, dns, meta, secrets
. "$PL_ROOT/lib/state.sh"

[ "$(id -u)" -eq 0 ] || { ui_err "нужен root"; exit 1; }

# ------------------------------------------------------------- загрузка ---
MODULES=()
for f in "$PL_ROOT"/modules/*.sh; do
  [ -e "$f" ] || continue
  MODULES+=("$f")
done

# Метаданные модуля читаются в подоболочке, чтобы переменные соседних
# модулей не затирали друг друга.
mod_meta() {  # mod_meta <файл> <переменная>
  ( . "$1"; eval "printf '%s' \"\${$2:-}\"" )
}
mod_call() {  # mod_call <файл> <функция> [аргументы]
  local f="$1" fn="$2"; shift 2
  ( . "$f"; "$fn" "$@" )
}

# ---------------------------------------------------------------- меню ----
menu_main() {
  local i choice f id name desc state port

  while true; do
    ui_head "packetlab" "$(pl_domain_or_unset) · $(pl_engine_line)"

    ui_section "протоколы"
    i=1
    for f in "${MODULES[@]}"; do
      name=$(mod_meta "$f" MOD_NAME)
      desc=$(mod_meta "$f" MOD_DESC)
      port=$(mod_meta "$f" MOD_PORT)/$(mod_meta "$f" MOD_PROTO)
      state=$(mod_call "$f" mod_status)
      ui_row "$i" "$name" "$state" "$port"
      i=$((i+1))
    done

    ui_section "сервер"
    ui_row "s" "статус и диагностика"   "$(pl_health)"   ""
    ui_row "u" "пользователи"           "up"             "$(pl_user_count)"
    ui_row "l" "ссылка-подписка"        "$(pl_sub_state)" ""
    ui_row "c" "сертификат"             "$(pl_cert_state)" "$(pl_cert_days)"
    ui_row "t" "тюнинг ядра"            "$(pl_sysctl_state)" ""

    ui_section ""
    printf '  %sq%s  выход\n\n' "$C_B" "$C_RST"

    choice=$(ui_ask "выбор")
    case "$choice" in
      ''|q|Q) printf '\n'; exit 0 ;;
      s) menu_health ;;
      u) menu_users ;;
      l) menu_sub ;;
      c) menu_cert ;;
      t) menu_sysctl ;;
      *)
        if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "${#MODULES[@]}" ]; then
          menu_module "${MODULES[$((choice-1))]}"
        else
          ui_err "нет такого пункта"; sleep 1
        fi
        ;;
    esac
  done
}

# --------------------------------------------------- проверки установки ---
# До установки: база должна быть здорова. Иначе модуль запишет инбаунд
# в конфиг, движок не поднимется, и протокол останется в состоянии down —
# ровно то, что происходит, когда порт уже кем-то занят.
pl_preflight() {
  local f="$1" engine port proto svc rc=0
  engine=$(mod_meta "$f" MOD_ENGINE)
  port=$(mod_meta "$f" MOD_PORT)
  proto=$(mod_meta "$f" MOD_PROTO)

  [ -n "$PL_DOMAIN" ] || { ui_err "домен не задан в $PL_META"; rc=1; }

  case "$engine" in
    sing-box)
      if ! sing-box check -c "$PL_SB" >/dev/null 2>&1; then
        ui_err "конфиг sing-box невалиден — сначала почини его"; rc=1
      fi ;;
  esac

  svc="$engine"
  if systemctl list-unit-files "$svc.service" >/dev/null 2>&1; then
    if ! systemctl is-active --quiet "$svc"; then
      ui_err "$svc не запущен — установка оставит протокол нерабочим"
      ui_note "journalctl -u $svc -n 20 --no-pager"
      rc=1
    fi
  fi

  if [ "$(mod_meta "$f" MOD_VIA_HAPROXY)" = yes ] && ! systemctl is-active --quiet haproxy; then
    ui_err "haproxy не запущен, а протокол ходит через него"; rc=1
  fi

  # Сертификат нужен не всем: REALITY обходится без него.
  if grep -q 'PL_CERT' "$f" && [ ! -f "$PL_CERT" ]; then
    ui_err "нет сертификата $PL_CERT"; rc=1
  fi

  # Занятый порт — это то, обо что спотыкается движок уже после записи конфига.
  if pl_port_listening "$port" "$proto"; then
    ui_err "порт $port/$proto уже кем-то занят"
    ui_note "ss -tlnp | grep :$port"
    rc=1
  fi

  return $rc
}

# После установки: сверяем не код возврата, а фактическое состояние.
pl_postflight() {
  local f="$1" engine
  engine=$(mod_meta "$f" MOD_ENGINE)
  case "$(mod_call "$f" mod_status)" in
    up)      ui_ok   "готово, порт слушается" ;;
    blocked) ui_warn "поднят, но порт закрыт в UFW — пункт «починить firewall»" ;;
    down)    ui_err  "инбаунд записан, но порт не слушается"
             ui_note "journalctl -u $engine -n 20 --no-pager" ;;
    off)     ui_err  "инбаунд в конфиге не появился" ;;
  esac
}

# ------------------------------------------------------- меню протокола ---
menu_module() {
  local f="$1" name state
  name=$(mod_meta "$f" MOD_NAME)

  while true; do
    state=$(mod_call "$f" mod_status)
    ui_head "$name" "$(mod_meta "$f" MOD_DESC) · $(mod_meta "$f" MOD_ENGINE)"

    printf '  состояние: %s\n' "$(ui_badge "$state")"
    case "$state" in
      blocked) ui_warn "инбаунд поднят, но порт закрыт в UFW — клиент получит таймаут" ;;
      down)    ui_warn "инбаунд в конфиге есть, но порт никто не слушает" ;;
    esac

    ui_section ""
    case "$state" in
      off) ui_row "1" "установить" "off" "" ;;
      *)
        ui_row "1" "показать ссылку"  "up" ""
        ui_row "2" "переустановить"   "up" ""
        ui_row "3" "удалить"          "up" ""
        [ "$state" = blocked ] && ui_row "4" "починить firewall" "blocked" ""
        ;;
    esac
    printf '  %sb%s  назад\n\n' "$C_B" "$C_RST"

    case "$(ui_ask "выбор")" in
      1) if [ "$state" = off ]; then
           if pl_preflight "$f"; then
             mod_call "$f" mod_install && pl_postflight "$f"
           else
             ui_note "установка отменена, конфиг не тронут"
           fi
         else
           printf '\n'; mod_call "$f" mod_link uri; printf '\n'
         fi
         ui_ask "enter" >/dev/null ;;
      2) ui_confirm "переустановить $name? текущие ключи будут заменены" \
           && { mod_call "$f" mod_remove \
                || { ui_err "удаление не удалось, установка отменена"; ui_ask "enter" >/dev/null; continue; }
                if pl_preflight "$f"; then
                  mod_call "$f" mod_install && pl_postflight "$f"
                else
                  ui_note "установка отменена, протокол остался удалённым"
                fi; }
         ui_ask "enter" >/dev/null ;;
      3) ui_confirm "удалить $name? откат — только переустановка с новыми ключами" \
           && { mod_call "$f" mod_remove && ui_ok "удалён"; }
         ui_ask "enter" >/dev/null ;;
      4) pl_ufw_open "$(mod_meta "$f" MOD_PORT)" "$(mod_meta "$f" MOD_PROTO)" \
           "$(mod_meta "$f" MOD_ID)" && ui_ok "правило добавлено" ;;
      b|B|'') return ;;
    esac
  done
}

# ---------------------------------------------------------- диагностика ---
# Сверяет конфиг / реально слушающие порты / UFW и показывает расхождения.
menu_health() {
  local f name cfg lst fw
  ui_head "диагностика" "конфиг · порт · firewall"

  ui_section "протоколы"
  for f in "${MODULES[@]}"; do
    name=$(mod_meta "$f" MOD_NAME)
    ui_row "" "$name" "$(mod_call "$f" mod_status)" \
      "$(mod_meta "$f" MOD_PORT)/$(mod_meta "$f" MOD_PROTO)"
  done

  ui_section "сервисы"
  for s in sing-box mihomo mita haproxy caddy packetlab-sub; do
    systemctl list-unit-files "$s.service" >/dev/null 2>&1 || continue
    if systemctl is-active --quiet "$s"; then ui_row "" "$s" up ""; else ui_row "" "$s" down ""; fi
  done

  ui_section "лишние правила UFW"
  pl_ufw_orphans || ui_note "нет"

  printf '\n'
  ui_ask "enter" >/dev/null
}

# ------------------------------------------------------- пользователи ----
# users.json — список объектов {name, sub_token}. Первый в списке владеет
# подпиской: сервер подписок берёт токен нулевого элемента.
pl_users_list() {
  python3 -c "
import json
for i,u in enumerate(json.load(open('$PL_USERS')),1):
    print(i, u.get('name','?'), u.get('sub_token','')[:8]+'…')" 2>/dev/null
}

menu_users() {
  local n i name tok
  while true; do
    ui_head "пользователи" "подпиской владеет первый в списке"
    ui_section "список"
    while read -r i name tok; do
      ui_row "$i" "$name" up "$tok"
    done < <(pl_users_list)

    ui_section ""
    ui_row "1" "добавить" up ""
    ui_row "2" "удалить"  up ""
    printf '  %sb%s  назад\n\n' "$C_B" "$C_RST"

    case "$(ui_ask "выбор")" in
      1) n=$(ui_ask "имя"); [ -z "$n" ] && continue
         if python3 - "$n" <<'PYADD'
import json,secrets,sys
p="/etc/packetlab/users.json"
d=json.load(open(p))
if any(u.get("name")==sys.argv[1] for u in d): sys.exit(1)
d.append({"name":sys.argv[1],"sub_token":secrets.token_hex(16)})
json.dump(d,open(p,"w"),indent=2,ensure_ascii=False)
PYADD
         then ui_ok "добавлен"; pl_sub_reload; else ui_err "имя уже занято"; fi
         ui_ask "enter" >/dev/null ;;
      2) n=$(ui_ask "имя"); [ -z "$n" ] && continue
         if ui_confirm "удалить $n? его токен подписки пропадёт безвозвратно"; then
           if python3 - "$n" <<'PYDEL'
import json,sys
p="/etc/packetlab/users.json"
d=json.load(open(p))
if not d or d[0].get("name")==sys.argv[1]: sys.exit(1)
rest=[u for u in d if u.get("name")!=sys.argv[1]]
if len(rest)==len(d): sys.exit(1)
json.dump(rest,open(p,"w"),indent=2,ensure_ascii=False)
PYDEL
           then ui_ok "удалён"; pl_sub_reload
           else ui_err "владельца подписки не удалить, остальных — только существующих"; fi
         fi
         ui_ask "enter" >/dev/null ;;
      b|B|'') return ;;
    esac
  done
}

# ----------------------------------------------------------- подписка ----
menu_sub() {
  local url tok code
  while true; do
    url=$(pl_sub_url)
    ui_head "ссылка-подписка" "формат выбирается по User-Agent клиента"

    if [ -n "$url" ]; then
      printf '\n  %s\n' "$url"
      ui_note "Karing и sing-box получат JSON, Shadowrocket — base64, остальные — Clash YAML"
    else
      ui_err "токен не найден в $PL_USERS"
    fi

    ui_section ""
    ui_row "1" "проверить отдачу"     "$(pl_sub_state)" ""
    ui_row "2" "сменить токен"        up ""
    ui_row "3" "перезапустить сервер" "$(pl_sub_state)" ""
    printf '  %sb%s  назад\n\n' "$C_B" "$C_RST"

    case "$(ui_ask "выбор")" in
      1) # Спрашиваем напрямую у сервера подписок: так проверяется он сам,
         # без участия DNS, haproxy и Caddy.
         tok=${url##*/}
         code=$(curl -s -o /tmp/pl-sub.out -w '%{http_code}' \
                 -H 'User-Agent: Karing' "http://127.0.0.1:9999/sub/$tok" 2>/dev/null)
         if [ "$code" = 200 ] && [ -s /tmp/pl-sub.out ]; then
           ui_ok "200, $(wc -c </tmp/pl-sub.out) байт"
           ui_note "нод в ответе: $(grep -o '\"tag\"' /tmp/pl-sub.out | wc -l)"
         else
           ui_err "сервер подписок ответил $code"
           ui_note "journalctl -u packetlab-sub -n 20 --no-pager"
         fi
         rm -f /tmp/pl-sub.out
         ui_ask "enter" >/dev/null ;;
      2) if ui_confirm "сменить токен? старая ссылка сразу перестанет работать"; then
           if python3 - <<'PYTOK'
import json,secrets
p="/etc/packetlab/users.json"
d=json.load(open(p)); d[0]["sub_token"]=secrets.token_hex(16)
json.dump(d,open(p,"w"),indent=2,ensure_ascii=False)
PYTOK
           then ui_ok "новый токен"; pl_sub_reload; else ui_err "не смог переписать $PL_USERS"; fi
         fi
         ui_ask "enter" >/dev/null ;;
      3) pl_sub_reload; sleep 1
         systemctl is-active --quiet packetlab-sub && ui_ok "поднят" || ui_err "не поднялся"
         ui_ask "enter" >/dev/null ;;
      b|B|'') return ;;
    esac
  done
}

# ---------------------------------------------------------- сертификат ---
menu_cert() {
  local l
  while true; do
    ui_head "сертификат" "wildcard, DNS-01 через Cloudflare"
    if [ -f "$PL_CERT" ]; then
      ui_row "" "$PL_DOMAIN" "$(pl_cert_state)" "$(pl_cert_days)"
      ui_note "истекает: $(openssl x509 -in "$PL_CERT" -noout -enddate 2>/dev/null | cut -d= -f2)"
    else
      ui_err "сертификата нет: $PL_CERT"
    fi

    ui_section ""
    ui_row "1" "проверить продление (dry-run)" up ""
    ui_row "2" "продлить принудительно"        up ""
    ui_row "3" "показать deploy-hook" \
      "$([ -x /etc/letsencrypt/renewal-hooks/deploy/packetlab.sh ] && printf up || printf off)" ""
    printf '  %sb%s  назад\n\n' "$C_B" "$C_RST"

    case "$(ui_ask "выбор")" in
      1) ui_info "certbot renew --dry-run, около минуты…"
         if certbot renew --dry-run --cert-name "$PL_DOMAIN" >/tmp/pl-certbot.log 2>&1; then
           ui_ok "продление пройдёт"
         else
           ui_err "не пройдёт, подробности в /tmp/pl-certbot.log"
           tail -5 /tmp/pl-certbot.log | while read -r l; do ui_note "$l"; done
         fi
         ui_ask "enter" >/dev/null ;;
      2) # Let's Encrypt: 5 дублирующих сертификатов на набор доменов в неделю,
         # принудительное продление тратит эту квоту.
         if ui_confirm "тратит недельный лимит Let's Encrypt. продолжить?"; then
           if certbot renew --force-renewal --cert-name "$PL_DOMAIN" >/tmp/pl-certbot.log 2>&1; then
             ui_ok "продлён"
             systemctl restart sing-box 2>/dev/null
           else
             ui_err "не вышло, подробности в /tmp/pl-certbot.log"
             tail -5 /tmp/pl-certbot.log | while read -r l; do ui_note "$l"; done
           fi
         fi
         ui_ask "enter" >/dev/null ;;
      3) # sing-box читает сертификат с диска и сам его не перечитывает —
         # без рестарта после продления всё тихо ляжет через 90 дней.
         if [ -f /etc/letsencrypt/renewal-hooks/deploy/packetlab.sh ]; then
           while read -r l; do ui_note "$l"; done < /etc/letsencrypt/renewal-hooks/deploy/packetlab.sh
         else
           ui_err "хука нет — sing-box не перезапустится после продления"
         fi
         ui_ask "enter" >/dev/null ;;
      b|B|'') return ;;
    esac
  done
}

# --------------------------------------------------------- тюнинг ядра ---
PL_SYSCTL=/etc/sysctl.d/99-packetlab.conf

menu_sysctl() {
  local r w q c
  while true; do
    r=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
    w=$(sysctl -n net.core.wmem_max 2>/dev/null || echo 0)
    q=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo '?')
    c=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '?')

    ui_head "тюнинг ядра" "буферы UDP · bbr + fq"
    ui_row "" "rmem_max" "$([ "$r" -ge 16777216 ] && printf up || printf off)" "$r"
    ui_row "" "wmem_max" "$([ "$w" -ge 16777216 ] && printf up || printf off)" "$w"
    ui_row "" "qdisc"    "$([ "$q" = fq ] && printf up || printf off)"  "$q"
    ui_row "" "congestion" "$([ "$c" = bbr ] && printf up || printf off)" "$c"
    ui_row "" "файл"     "$([ -f "$PL_SYSCTL" ] && printf up || printf off)" "$PL_SYSCTL"

    ui_section ""
    ui_row "1" "применить заново" up ""
    ui_row "2" "убрать тюнинг"    up ""
    printf '  %sb%s  назад\n\n' "$C_B" "$C_RST"

    case "$(ui_ask "выбор")" in
      1) if [ -f "$PL_SYSCTL" ]; then
           sysctl -p "$PL_SYSCTL" >/dev/null 2>&1
           [ "$(pl_sysctl_state)" = up ] \
             && ui_ok "применено" \
             || ui_warn "применилось не полностью — проверь, есть ли bbr в ядре"
         else
           ui_err "нет $PL_SYSCTL — перезапусти install.sh"
         fi
         ui_ask "enter" >/dev/null ;;
      2) # sysctl не откатывает уже применённое: значения по умолчанию
         # вернутся только после перезагрузки.
         if ui_confirm "удалить $PL_SYSCTL? текущие значения доживут до перезагрузки"; then
           rm -f "$PL_SYSCTL" && ui_ok "файл удалён"
         fi
         ui_ask "enter" >/dev/null ;;
      b|B|'') return ;;
    esac
  done
}

# ----------------------------------------------------------------- CLI ----
case "${1:-}" in
  '')        menu_main ;;
  status)    menu_health ;;
  sub)       pl_sub_url ;;
  link)      for f in "${MODULES[@]}"; do mod_call "$f" mod_link "${2:-uri}"; done ;;
  *)         ui_err "неизвестная команда: $1"; exit 1 ;;
esac
